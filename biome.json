{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "assist": { "actions": { "source": { "organizeImports": "on" } } },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "complexity": {
                "noImportantStyles": "off"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        },
        "globals": ["ajaxurl", "knabbel_admin"]
    },
    "css": {
        "formatter": {
            "indentStyle": "space",
            "indentWidth": 4
        }
    },
    "files": {
        "includes": [
            "**/assets/**/*.js",
            "**/assets/**/*.css",
            "playwright.config.ts",
            "tests/playwright/**/*.ts",
            "!**/vendor",
            "!**/node_modules"
        ]
    }
}
